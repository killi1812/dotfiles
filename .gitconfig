[include]
  path = ~/.gitconfig.personal

# when working on work projects
[includeIf "gitdir:**/posao/**/.git"]
  path = ~/.gitconfig.work

# when working on work projects
[includeIf "gitdir:**/uni/**/.git"]
  path = ~/.gitconfig.uni

#[gpg]
#    program = gpg
#[commit]
#    gpgSign = true
[init]
	defaultBranch = master
[pull]
	rebase = true
